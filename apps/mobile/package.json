{
  "name": "vietbiz-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "VietBiz for iOS and Android: the accountant-web workspace in a Capacitor shell with system-browser login (OIDC + PKCE).",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync",
    "assets": "node scripts/make-assets.mjs && capacitor-assets generate --ios --android --iconBackgroundColor '#183a32' --splashBackgroundColor '#f5f6ef' --splashBackgroundColorDark '#12302a'",
    "android:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run sync && cd android && ./gradlew bundleRelease",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2"
  }
}
